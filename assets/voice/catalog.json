  "messages": [
    {
      "id": "m01",
      "text": "siempre te recordaré"
    },
    {
      "id": "m02",
      "text": "siempre en mis pensamientos"
    },
    {
      "id": "m03",
      "text": "gracias"
    },
    {
      "id": "m04",
      "text": "sigue así"
    },
    {
      "id": "m05",
      "text": "lo estás haciendo bien"
    },
    {
      "id": "m06",
      "text": "descansa, lo estás haciendo bien"
    },
    {
      "id": "m07",
      "text": "también te extraño"
    },
    {
      "id": "m08",
      "text": "hoy vine a verte"
    },
    {
      "id": "m09",
      "text": "qué gusto me da verte"
    },
    {
      "id": "m10",
      "text": "cuánto tiempo sin verte"
    },
    {
      "id": "m11",
      "text": "te extrañaba mucho"
    },
    {
      "id": "m12",
      "text": "déjame verte un ratito"
    },
    {
      "id": "m13",
      "text": "tu luz me trajo hasta aquí"
    },
    {
      "id": "m14",
      "text": "seguí las flores hasta ti"
    },
    {
      "id": "m15",
      "text": "gracias por las flores"
    },
    {
      "id": "m16",
      "text": "gracias por acordarte de mí"
    },
    {
      "id": "m17",
      "text": "cada año vuelvo a verte"
    },
    {
      "id": "m18",
      "text": "vine a darte un abrazo"
    },
    {
      "id": "m19",
      "text": "qué bonito es volver a verte"
    },
    {
      "id": "m20",
      "text": "aquí sigo, cerquita de ti"
    },
    {
      "id": "m21",
      "text": "sigo en tu corazón"
    },
    {
      "id": "m22",
      "text": "te llevo en el corazón"
    },
    {
      "id": "m23",
      "text": "nunca me olvido de ti"
    },
    {
      "id": "m24",
      "text": "me acuerdo de ti todos los días"
    },
    {
      "id": "m25",
      "text": "me acuerdo de tu risa"
    },
    {
      "id": "m26",
      "text": "mientras me recuerdes, aquí estoy"
    },
    {
      "id": "m27",
      "text": "vivo en tus recuerdos"
    },
    {
      "id": "m28",
      "text": "me llevo tu cariño"
    },
    {
      "id": "m29",
      "text": "nuestro cariño no se acaba"
    },
    {
      "id": "m30",
      "text": "guardo cada momento contigo"
    },
    {
      "id": "m31",
      "text": "aquí estoy contigo"
    },
    {
      "id": "m32",
      "text": "camino a tu lado"
    },
    {
      "id": "m33",
      "text": "te acompaño aunque no me veas"
    },
    {
      "id": "m34",
      "text": "estoy más cerca de lo que crees"
    },
    {
      "id": "m35",
      "text": "siempre te cuido"
    },
    {
      "id": "m36",
      "text": "seguimos juntos"
    },
    {
      "id": "m37",
      "text": "nunca me fui del todo"
    },
    {
      "id": "m38",
      "text": "estoy en cada vela que enciendes"
    },
    {
      "id": "m39",
      "text": "me quedo un ratito contigo"
    },
    {
      "id": "m40",
      "text": "te veo y sonrío"
    },
    {
      "id": "m41",
      "text": "cuánto te quiero"
    },
    {
      "id": "m42",
      "text": "me llenas de orgullo"
    },
    {
      "id": "m43",
      "text": "tú puedes"
    },
    {
      "id": "m44",
      "text": "confía en ti"
    },
    {
      "id": "m45",
      "text": "todo va a estar bien"
    },
    {
      "id": "m46",
      "text": "no tengas miedo"
    },
    {
      "id": "m47",
      "text": "eres más fuerte de lo que crees"
    },
    {
      "id": "m48",
      "text": "ve con calma, no hay prisa"
    },
    {
      "id": "m49",
      "text": "sigue adelante, yo te acompaño"
    },
    {
      "id": "m50",
      "text": "vive bonito"
    },
    {
      "id": "m51",
      "text": "sé feliz, te lo mereces"
    },
    {
      "id": "m52",
      "text": "ríe mucho, me encanta tu risa"
    },
    {
      "id": "m53",
      "text": "cuida a los tuyos"
    },
    {
      "id": "m54",
      "text": "abraza fuerte a quien quieres"
    },
    {
      "id": "m55",
      "text": "abrígate y come bien"
    },
    {
      "id": "m56",
      "text": "date un descanso, te lo has ganado"
    },
    {
      "id": "m57",
      "text": "tu esfuerzo vale mucho"
    },
    {
      "id": "m58",
      "text": "eres luz para los tuyos"
    },
    {
      "id": "m59",
      "text": "te mando un abrazo grande"
    },
    {
      "id": "m60",
      "text": "gracias por tanto cariño"
    },
    {
      "id": "m61",
      "text": "hoy es fiesta, disfrútala"
    },
    {
      "id": "m62",
      "text": "canta y baila por mí"
    }
  ],
